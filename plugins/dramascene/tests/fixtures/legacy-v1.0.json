  "space": "室内小几与椅子—帘口—近庭同一株海棠。帘内人可正常起身走到帘内侧；边框仍遮住花叶细节。卷帘人可以调整帘高、转向同伴，但不开成无遮拦的全景。",
  "source_units": [
    {
      "id": "P1",
      "text": "昨夜雨疏风骤",
      "meaning": "过去一夜雨疏风急；不重演夜景"
    },
    {
      "id": "P2",
      "text": "浓睡不消残酒",
      "meaning": "深睡后酒意仍在；不是只指杯中的酒"
    },
    {
      "id": "P3",
      "text": "试问卷帘人",
      "meaning": "向卷帘者试探问花，问语为改编补足"
    },
    {
      "id": "P4",
      "text": "却道海棠依旧",
      "meaning": "对方判断没变，与问者在意的细节形成差异"
    },
    {
      "id": "P5",
      "text": "知否，知否？",
      "meaning": "重复关切而非训斥"
    },
    {
      "id": "P6",
      "text": "应是绿肥红瘦",
      "meaning": "推测叶繁花疏，不作亲眼证实"
    }
  ],
  "dialogues": [
    {
      "id": "D1",
      "speaker": "帘内人",
      "text": "你帮我看看，外头那棵海棠怎么样了？",
      "source_ids": [
        "P3"
      ]
    },
    {
      "id": "D2",
      "speaker": "卷帘人",
      "text": "我看着跟原来差不多，花还开着呢。",
      "source_ids": [
        "P4"
      ]
    },
    {
      "id": "D3",
      "speaker": "帘内人",
      "text": "昨晚雨下得稀稀落落的，风倒挺急。我睡得那么沉，酒劲儿还是没过去。",
      "source_ids": [
        "P1",
        "P2"
      ]
    },
    {
      "id": "D4",
      "speaker": "帘内人",
      "text": "你仔细看了吗？真跟原来一样？",
      "source_ids": [
        "P5"
      ]
    },
    {
      "id": "D5",
      "speaker": "帘内人",
      "text": "我估计，叶子应该更茂盛了，花倒少了些。",
      "source_ids": [
        "P6"
      ]
    }
  ],
  "voiceovers": [
    {
      "id": "N1",
      "text": "她问的是花有没有变化，不只是花还在不在。",
      "source_ids": [
        "P3",
        "P4",
        "P5"
      ]
    },
    {
      "id": "N2",
      "text": "这里的“应该”，还带着猜测。",
      "source_ids": [
        "P6"
      ]
    }
  ],
